        "notable": [
          "systemctl daemon-reload >/dev/null 2>&1 || :",
          "systemctl disable --now imira.service >/dev/null 2>&1 || :"
        ],
        "body": "# Installed straight into /etc/systemd/system, so only a reload is needed.\n# Guarded: during image builds there is no running systemd.\nsystemctl daemon-reload >/dev/null 2>&1 || :\n# Upgrades: disable the pre-0.10.1 boot service.\nif [ \"$1\" -gt 1 ]; then\n    systemctl disable --now imira.service >/dev/null 2>&1 || :\nfi\n# PulseAudio only reads xpolicy.conf.d on startup; kick the user instance\n# (systemd --user respawns it immediately). Without the rule the daemon's\n# monitor capture would be rerouted to the mic \u2014 which it refuses, so audio\n# would stay off until the next reboot. Not pkill -x: busybox matches the\n# full argv[0] (/usr/bin/pulseaudio) and never hits; pidof does.\nP=$(pidof pulseaudio 2>/dev/null) && kill $P >/dev/null 2>&1 || :\n"
      },
      {
        "type": "preuninstall",
        "interpreter": "/bin/sh",
        "lines": 4,
        "notable": [
          "systemctl stop imira.service >/dev/null 2>&1 || :",
          "systemctl disable imira.service >/dev/null 2>&1 || :"
        ],
        "body": "# $1 = 0 on erase, >= 1 on upgrade \u2014 only stop the service when going away.\nif [ \"$1\" = \"0\" ]; then\n    systemctl stop imira.service >/dev/null 2>&1 || :\n    systemctl disable imira.service >/dev/null 2>&1 || :\nfi\n"
      },
      {
        "type": "postuninstall",
