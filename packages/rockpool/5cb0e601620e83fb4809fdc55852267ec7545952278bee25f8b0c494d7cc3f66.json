        "body": "systemctl-user stop rockpoold.service || :\nsystemctl-user disable rockpoold.service || :\n# Remember the installed override before RPM replaces it, including reinstalls.\nsha256sum /etc/systemd/system/bluetooth.service.d/50-libpebble3d.conf \\\n    > /run/rockpool-bluetooth-override.sha256 2>/dev/null || :\n"
      },
      {
        "type": "postinstall",
        "interpreter": "/bin/sh",
        "lines": 12,
        "notable": [
          "systemctl daemon-reload || :",
          "systemctl try-restart bluetooth.service || :",
          "systemctl-user daemon-reload || :",
          "systemctl-user start libpebble3d.service || :",
          "systemctl-user try-restart libpebble3d.service || :"
        ],
        "body": "update-desktop-database\nsystemctl daemon-reload || :\n# Applying a new override needs a restart; unchanged upgrades must preserve links.\nif ! sha256sum --check --status /run/rockpool-bluetooth-override.sha256 2>/dev/null; then\n    systemctl try-restart bluetooth.service || :\nfi\nrm -f /run/rockpool-bluetooth-override.sha256\nsystemctl-user daemon-reload || :\nif [ \"$1\" = \"1\" ]; then\n    systemctl-user start libpebble3d.service || :\nelse\n    systemctl-user try-restart libpebble3d.service || :\nfi\n"
      },
      {
        "type": "preuninstall",
        "interpreter": "/bin/sh",
        "lines": 3,
        "notable": [
          "systemctl-user stop libpebble3d.service || :"
        ],
        "body": "if [ \"$1\" = \"0\" ]; then\n    systemctl-user stop libpebble3d.service || :\nfi\n"
      },
