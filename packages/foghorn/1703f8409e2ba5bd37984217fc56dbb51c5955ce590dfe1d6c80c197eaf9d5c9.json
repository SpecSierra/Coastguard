    "scriptlets": [
      {
        "type": "postinstall",
        "interpreter": "/bin/sh",
        "lines": 2,
        "notable": [
          "systemctl-user daemon-reload || :",
          "systemctl-user try-restart foghornd.service || :"
        ],
        "body": "# No user session exists during a package transaction, so starting is left to the\n# GUI or the next login. Without try-restart an upgraded daemon keeps running.\nsystemctl-user daemon-reload || :\nsystemctl-user try-restart foghornd.service || :\n\n# After the transaction, so an obsoleted foghorn-appsupport's %preun, which\n# disables the same unit, has already run.\n"
      },
      {
        "type": "preuninstall",
        "interpreter": "/bin/sh",
        "lines": 16,
        "notable": [
          "systemctl-user stop foghornd.service || :",
          "systemctl disable --now \"foghorn-appsupport@$user.service\" \\",
          "systemctl stop \"foghorn-appsupport-sync@$user.service\" || :",
          "systemd-run --no-block --unit=foghorn-cleanup \\"
        ],
        "body": "if [ $1 -eq 0 ]; then\n    systemctl-user stop foghornd.service || :\n    user=\"$(getent passwd 100000 | cut -d: -f1)\"\n    if [ -n \"$user\" ]; then\n        systemctl disable --now \"foghorn-appsupport@$user.service\" \\\n            \"foghorn-appsupport-sync@$user.path\" || :\n        systemctl stop \"foghorn-appsupport-sync@$user.service\" || :\n        # Removing the APK can mean starting App Support, so it runs after the\n        # transaction from copies of the files about to be deleted.\n        cleanup=/run/foghorn-cleanup\n        mkdir -p \"$cleanup\"\n        cp /usr/libexec/foghorn-appsupport /usr/share/foghorn/appsupport/foghorn.sh \\\n            /usr/share/foghorn/appsupport/foghorn-appsupport.apk \"$cleanup/\" || :\n        systemd-run --no-block --unit=foghorn-cleanup \\\n            --setenv=FOGHORN_SHARE=\"$cleanup\" \\\n            /bin/sh -c \"$cleanup/foghorn-appsupport remove $user; rm -rf $cleanup /var/lib/foghorn /run/foghorn\" || :\n    fi\nfi\n"
      },
      {
        "type": "postuninstall",
        "interpreter": "/bin/sh",
        "lines": 4,
        "notable": [
          "systemctl daemon-reload || :",
          "systemctl-user daemon-reload || :"
        ],
        "body": "if [ $1 -eq 0 ]; then\n    systemctl daemon-reload || :\n    systemctl-user daemon-reload || :\nfi\n"
      },
      {
        "type": "posttrans",
        "interpreter": "/bin/sh",
        "lines": 9,
        "notable": [
          "systemctl daemon-reload || :",
          "systemctl enable \"foghorn-appsupport@$user.service\" \"foghorn-appsupport-sync@$user.path\" || :",
          "systemctl start \"foghorn-appsupport-sync@$user.path\" || :",
          "if systemctl -q is-active \"appsupport@$user.service\"; then",
          "systemctl restart \"foghorn-appsupport@$user.service\" || :"
        ],
        "body": "systemctl daemon-reload || :\nuser=\"$(getent passwd 100000 | cut -d: -f1)\"\nif [ -n \"$user\" ]; then\n    systemctl enable \"foghorn-appsupport@$user.service\" \"foghorn-appsupport-sync@$user.path\" || :\n    systemctl start \"foghorn-appsupport-sync@$user.path\" || :\n    if systemctl -q is-active \"appsupport@$user.service\"; then\n        systemctl restart \"foghorn-appsupport@$user.service\" || :\n    fi\nfi\n"
      }
